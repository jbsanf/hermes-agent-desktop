{
  "app-id": "io.github.jbsanf.HermesDesktop",
  "runtime": "org.freedesktop.Platform",
  "runtime-version": "25.08",
  "sdk": "org.freedesktop.Sdk",
  "base": "org.electronjs.Electron2.BaseApp",
  "base-version": "25.08",
  "command": "hermes-desktop",
  "default-branch": "stable",
  "separate-locales": false,
  "finish-args": [
    "--share=ipc",
    "--share=network",
    "--socket=wayland",
    "--socket=fallback-x11",
    "--socket=pulseaudio",
    "--device=dri",
    "--socket=ssh-auth",
    "--persist=.ssh",
    "--talk-name=org.freedesktop.secrets",
    "--env=XCURSOR_PATH=/run/host/user-share/icons:/run/host/share/icons"
  ],
  "cleanup": [
    "/include",
    "/share/man",
    "/lib/pkgconfig",
    "/lib/debug"
  ],
  "build-options": {
    "strip": true,
    "no-debuginfo": true,
    "env": {
      "GITHUB_SHA": "f97608f178d1ffeca59860195ab7da295f7c8e5f",
      "GITHUB_REF_NAME": "v2026.9.24",
      "FLATPAK_PACKAGE_VERSION": "0.21.5",
      "ELECTRON_VERSION": "40.10.2"
    }
  },
  "modules": [
    {
      "name": "git",
      "buildsystem": "simple",
      "build-commands": [
        "make -j${FLATPAK_BUILDER_N_JOBS} prefix=/app NO_RUST=YesPlease NO_GETTEXT=YesPlease NO_TCLTK=YesPlease NO_PERL=YesPlease all",
        "make prefix=/app INSTALL_SYMLINKS=YesPlease NO_RUST=YesPlease NO_GETTEXT=YesPlease NO_TCLTK=YesPlease NO_PERL=YesPlease install"
      ],
      "sources": [
        {
          "type": "archive",
          "archive-type": "tar-gzip",
          "url": "https://api.github.com/repos/git/git/tarball/refs/tags/v2.55.0",
          "sha256": "8585abb7ea9636dd9bf95b04301a19f503acddc5140ec4f5659a71d40ee2aed2"
        }
      ]
    },
    {
      "name": "node",
      "buildsystem": "simple",
      "build-commands": [
        "cp -a bin include lib share /app/"
      ],
      "sources": [
        {
          "type": "archive",
          "url": "https://nodejs.org/dist/v26.10.0/node-v26.10.0-linux-x64.tar.xz",
          "sha256": "ca70e9e349de048b9522abb3adc05b3bd6f43c5ffd3ec57916c7da292f59f022"
        }
      ]
    },
    {
      "name": "electron",
      "buildsystem": "simple",
      "build-commands": [
        "mkdir -p /app/lib/hermes-electron",
        "cp -a . /app/lib/hermes-electron/"
      ],
      "sources": [
        {
          "type": "archive",
          "url": "https://github.com/electron/electron/releases/download/v40.10.2/electron-v40.10.2-linux-x64.zip",
          "sha256": "0246201400600ac089c51a36f15a8045b5db723ba42b864f732a9b4e48731e97",
          "strip-components": 0
        }
      ]
    },
    {
      "name": "python-dependencies",
      "buildsystem": "simple",
      "build-commands": [
        "python3 -c \"import sys; assert sys.version_info[:2] == (3, 13), sys.version\"",
        "pip3 install --no-index --no-deps --no-compile --require-hashes --ignore-installed --prefix=/app --find-links=python-wheels -r requirements.txt"
      ],
      "sources": [
        "packaging/python-sources.json",
        {
          "type": "file",
          "path": "packaging/requirements.txt"
        }
      ]
    },
    {
      "name": "hermes-desktop",
      "buildsystem": "simple",
      "build-commands": [
        "bash build-desktop.sh",
        "python3 install-payload.py",
        "install -Dm755 hermes-desktop /app/bin/hermes-desktop",
        "install -Dm755 hermes-backend /app/libexec/hermes-backend",
        "install -Dm644 hermes-backend.py /app/libexec/hermes-backend.py",
        "install -Dm644 io.github.jbsanf.HermesDesktop.desktop /app/share/applications/io.github.jbsanf.HermesDesktop.desktop",
        "install -Dm644 io.github.jbsanf.HermesDesktop.metainfo.xml /app/share/metainfo/io.github.jbsanf.HermesDesktop.metainfo.xml",
        "install -Dm644 upstream/apps/desktop/assets/icon.png /app/share/icons/hicolor/1024x1024/apps/io.github.jbsanf.HermesDesktop.png",
        "install -Dm644 upstream/LICENSE /app/share/licenses/hermes-desktop/LICENSE"
      ],
      "sources": [
        {
          "type": "archive",
          "archive-type": "tar-gzip",
          "url": "https://api.github.com/repos/NousResearch/hermes-agent/tarball/f97608f178d1ffeca59860195ab7da295f7c8e5f",
          "sha256": "b71f4b7d4fe5b158ed9bbbeb73f5eb107f2f05e54bd582d32c2d9f718b58d9b0",
          "dest": "upstream"
        },
        {
          "type": "patch",
          "path": "patches/flatpak-integration.patch",
          "options": [
            "-d",
            "upstream"
          ]
        },
        {
          "type": "archive",
          "url": "https://artifacts.electronjs.org/headers/dist/v40.10.2/node-v40.10.2-headers.tar.gz",
          "sha256": "de1d91f029485ac5bb3eb542c2e57348dfd4d1714cf9caa940c49dba66306563",
          "dest": "electron-headers"
        },
        "packaging/npm-sources.json",
        {
          "type": "file",
          "path": "scripts/build-desktop.sh"
        },
        {
          "type": "file",
          "path": "scripts/install-payload.py"
        },
        {
          "type": "file",
          "path": "packaging/hermes-desktop"
        },
        {
          "type": "file",
          "path": "packaging/hermes-backend"
        },
        {
          "type": "file",
          "path": "packaging/hermes-backend.py"
        },
        {
          "type": "file",
          "path": "packaging/io.github.jbsanf.HermesDesktop.desktop"
        },
        {
          "type": "file",
          "path": "packaging/io.github.jbsanf.HermesDesktop.metainfo.xml"
        }
      ]
    },
    {
      "name": "desktop-icons",
      "buildsystem": "simple",
      "build-commands": [
        "PYTHONPATH=/app/lib/python3.13/site-packages python3 install-icons.py"
      ],
      "sources": [
        {
          "type": "file",
          "path": "scripts/install-icons.py"
        }
      ]
    }
  ]
}
